{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lirrly",
  "version": "0.3.0",
  "identifier": "com.mshrmnsr.lirrly",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Lirrly",
        "width": 1180,
        "height": 760,
        "minWidth": 860,
        "minHeight": 540,
        "visible": true,
        "resizable": true,
        "center": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 20,
          "y": 20
        }
      },
      {
        "label": "flowbar",
        "url": "/",
        "width": 96,
        "height": 54,
        "visible": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "focus": false,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset: https://asset.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost tauri:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; media-src 'self' blob:; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "Lirrly.entitlements",
      "hardenedRuntime": true
    }
  }
}
